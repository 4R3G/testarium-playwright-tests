# Adres frontu Testarium. API jest osiągane przez proxy Vite pod tym samym
# originem (/api), więc portu backendu tu nie podajemy.
BASE_URL=http://localhost:5173

# Katalog aplikacji (względem tego repozytorium albo bezwzględny). Stąd
# scripts/environment.mts uruchamia Dockera, migracje, seed i `pnpm dev`.
TESTARIUM_APP_DIR=../TSM

# false — Playwright nie podnosi środowiska (np. BASE_URL na zdalnym serwerze).
E2E_START_ENV=true

# Konta demo z seeda aplikacji (pnpm db:seed w repozytorium TSM).
E2E_PASSWORD=TestariumDemo2026!
ADMIN_EMAIL=admin@testarium.local
COORDINATOR_EMAIL=marta.kowalska@testarium.local
TESTER_EMAIL=tomasz.nowak@testarium.local

# Baza aplikacji — tylko dla jednorazowych kont testu blokady (PK-1041).
# Domyślnie DATABASE_URL z .env aplikacji (TESTARIUM_APP_DIR); ustaw, gdy
# testy chodzą przeciw bazie, której ten plik nie opisuje.
# E2E_DATABASE_URL=postgresql://testarium:testarium@localhost:5434/testarium

# Opóźnienie każdej akcji przeglądarki w ms — do oglądania testów z --headed.
# E2E_SLOW_MO=500

# Mailpit — skrzynka dla raportów cyklicznych (etap 4).
MAILPIT_URL=http://localhost:8025
